# API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
PRIMARY_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.7

# Vector Store Configuration
VECTOR_STORE_TYPE=chromadb
VECTOR_STORE_PATH=./data/embeddings/chroma_db
COLLECTION_NAME_AI_ETHICS=brusseau_ai_ethics
COLLECTION_NAME_BUSINESS_ETHICS=brusseau_business_ethics

# Retrieval Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
